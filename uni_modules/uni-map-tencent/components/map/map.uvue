		       "unixVer": "4.61",
		       "unixVaporVer": "5.0"
		     }
		   }
		 }
		 */
		includePoints ?: Array<LocationObject> | null,
		/**
		 * 是否显示3D楼块
		 * @uniPlatform {
		   "app": {
		     "android": {
		       "uniVer": "√",
		       "unixVer": "4.31",
		       "unixVaporVer": "5.21"
		     },
		     "ios": {
