		       "unixVer": "4.61",
		       "unixVaporVer": "5.0"
		     }
		   }
		 }
		 */
		showCompass ?: boolean,
		/**
		 * 是否支持缩放
		 * @uniPlatform {
		   "app": {
		     "android": {
		       "uniVer": "√",
		       "unixVer": "4.31",
		       "unixVaporVer": "5.21"
		     },
		     "ios": {
		       "uniVer": "√",
