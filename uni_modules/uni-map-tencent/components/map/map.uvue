		     },
		     "harmony": {
		       "uniVer": "4.25",
		       "unixVer": "4.61",
		       "unixVaporVer": "5.0"
		     }
		   }
		 }
		 */
		enableZoom ?: boolean,
		/**
		 * 是否支持拖动
		 * @uniPlatform {
		   "app": {
		     "android": {
		       "uniVer": "√",
		       "unixVer": "4.31",
		       "unixVaporVer": "5.21"
		     },
		     "ios": {
		       "uniVer": "√",
		       "unixVer": "4.31",
		       "unixVaporVer": "5.11"
		     },
		     "harmony": {
