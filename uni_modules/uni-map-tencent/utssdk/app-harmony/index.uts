import { MapController, MapOptions, Marker as TencentMarker, LatLng, MarkerOptions, ImageEntity, LocationInfo, PositionAnchor, Point, InfoWindow, InfoWindowInfo, Align, MapRect, MarkerMoveAlongOptions, Line, LineType, LineOptions, NormalLineExtraParam, DottedLineExtraParam, Segment, Polygon as TencentPolygon, PolygonOptions, Circle as TencentCircle, CircleOptions, CustomTileOverlay, OnRegionChangeListener, MapEvent, MapPoi } from '@tencentmap/map'
